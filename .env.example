# MetaRetail AI - Environment Configuration

# Server Settings
PROJECT_NAME="MetaRetail AI"
API_V1_STR="/api"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# Database Settings
DATABASE_URL="sqlite:///./metaretail.db"
# Example PostgreSQL migration URL:
# DATABASE_URL="postgresql://user:password@localhost:5432/metaretail_db"

# AI & Camera Settings
CAMERA_INDEX=0
DEFAULT_CONFIDENCE_THRESHOLD=0.45
YOLO_MODEL_PATH="models/yolo/yolov8n.pt"
VIT_MODEL_NAME="google/vit-base-patch16-224"
VIT_MODEL_PATH="models/vit/vit_retail_finetuned.pth"
TRACKER_TYPE="bytetrack"

# Inventory Settings
DEFAULT_LOW_STOCK_THRESHOLD=2

# CORS & Frontend Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
